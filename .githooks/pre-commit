#!/usr/bin/env bash
# Pre-commit hook: run ruff + pytest on staged backend Python files
# Matches CI pipeline: ruff check + pytest tests/ -v
# Install: git config core.hooksPath .githooks

set -euo pipefail

# Only run if there are staged Python files in backend/
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.py$' || true)
if [ -z "$STAGED" ]; then
    exit 0
fi

# ── Ruff ─────────────────────────────────────────────────────────────────────
echo "▸ Running ruff check (matches CI)…"
RUFF=""
for cmd in ruff "python3 -m ruff" "python -m ruff"; do
    if $cmd --version &>/dev/null 2>&1; then
        RUFF="$cmd"
        break
    fi
done

if [ -z "$RUFF" ]; then
    echo "⚠ ruff not found — skipping lint check"
else
    $RUFF check backend/
    echo "✓ ruff checks passed"
fi

# ── Pytest ───────────────────────────────────────────────────────────────────
# Find a Python (≥3.12) that has sqlalchemy installed (matches CI environment)
PYTHON=""
for cmd in python python3 "C:/Python312/python.exe"; do
    if $cmd -c "import sqlalchemy" &>/dev/null 2>&1; then
        PYTHON="$cmd"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "⚠ Python with deps not found — skipping tests (CI will run them)"
    exit 0
fi

echo "▸ Running pytest (matches CI)…"

# CI supplies these from repository secrets, which a local hook has no access
# to.  Without them app.config fails to construct and *every* test errors at
# collection — so the hook reported 49 failures and 319 errors that had nothing
# to do with the staged change.  Supplying local test defaults makes the hook
# self-sufficient; anything already exported still wins.
#
# These are the same throwaway values used by docs/RUNNING.md for local test
# runs.  The host/port/password match the local development database and the
# dedicated `fittrack_test` database — never the development database itself,
# which teardown would destroy.
export SECRET_KEY="${SECRET_KEY:-test-secret-key-for-ci-only}"
export DEBUG="${DEBUG:-true}"
export TEST_DATABASE_URL="${TEST_DATABASE_URL:-postgresql+asyncpg://fittrack:fittrack_dev@localhost:5432/fittrack_test}"
export REDIS_URL="${REDIS_URL:-redis://:redis_dev_password@localhost:6379/0}"

$PYTHON -m pytest backend/tests/ -v --tb=short -q
echo "✓ tests passed"
