#!/usr/bin/env bash
# Pre-commit hook: run ruff + pytest on staged backend files
# Matches CI pipeline: ruff check + pytest
# Install: git config core.hooksPath .githooks

set -euo pipefail

# Only run if there are staged Python files in backend/
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.py$' || true)
if [ -z "$STAGED" ]; then
    exit 0
fi

echo "▸ Running ruff check (matches CI)…"
if command -v ruff &>/dev/null; then
    ruff check backend/
elif python3 -m ruff --version &>/dev/null 2>&1; then
    python3 -m ruff check backend/
elif python -m ruff --version &>/dev/null 2>&1; then
    python -m ruff check backend/
else
    echo "⚠ ruff not found — skipping lint check"
fi

echo "▸ Running pytest (matches CI)…"
if command -v pytest &>/dev/null; then
    pytest backend/tests/ -v --tb=short -q
elif python3 -m pytest --version &>/dev/null 2>&1; then
    python3 -m pytest backend/tests/ -v --tb=short -q
elif python -m pytest --version &>/dev/null 2>&1; then
    python -m pytest backend/tests/ -v --tb=short -q
else
    echo "⚠ pytest not found — skipping tests"
fi

echo "✓ pre-commit checks passed"
