#!/usr/bin/env bash
# Pre-commit hook: run ruff on staged backend Python files.
# CI is the authority for the full test suite — see .github/workflows/test.yml.
# Install: git config core.hooksPath .githooks

set -euo pipefail

# Only run if there are staged Python files in backend/
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.py$' || true)
if [ -z "$STAGED" ]; then
    exit 0
fi

# ── Ruff ─────────────────────────────────────────────────────────────────────
echo "▸ Running ruff on staged backend Python files…"
RUFF=""
for cmd in ruff "python3 -m ruff" "python -m ruff"; do
    if $cmd --version &>/dev/null 2>&1; then
        RUFF="$cmd"
        break
    fi
done

if [ -z "$RUFF" ]; then
    # Fail-open: warn but don't block the commit. CI enforces lint.
    echo "⚠ ruff not found — skipping lint check (CI will enforce it)"
else
    $RUFF check $STAGED
    echo "✓ ruff checks passed"
fi
