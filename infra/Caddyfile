{
    email admin@example.com
}

:80 {
    redir https://{host}{uri} permanent
}

{$DOMAIN:localhost} {
    # Frontend — Next.js basePath is /fittrack
    handle /fittrack/* {
        reverse_proxy frontend:3000
    }

    # Backend API
    handle /api/v1/* {
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    # Root → redirect to /fittrack
    handle / {
        redir /fittrack permanent
    }

    # tls internal is only for localhost — Caddy auto-detects this.
    # For real domains, Caddy automatically obtains Let's Encrypt certs.
    # Do NOT add "tls internal" here; the deploy workflow resets this file
    # on every deploy, so any manual edits would be lost.
}
