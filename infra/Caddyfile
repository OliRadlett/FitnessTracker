{
    email admin@example.com
}

:80 {
    redir https://{host}{uri} permanent
}

{$DOMAIN:localhost} {
    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Permitted-Cross-Domain-Policies none
        Permissions-Policy camera=(), microphone=(), geolocation=()
        -Server
    }

    # Frontend — Next.js basePath is /fittrack
    # /fittrack* matches /fittrack, /fittrack/, /fittrack/dashboard, etc.
    handle /fittrack* {
        reverse_proxy frontend:3000
    }

    # NextAuth error redirects omit basePath — catch and redirect
    @nextauth path /api/auth /api/auth/*
    redir @nextauth /fittrack{uri} permanent

    # Backend API
    handle /api/v1* {
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    # Root → redirect to /fittrack
    handle / {
        redir /fittrack permanent
    }
}
