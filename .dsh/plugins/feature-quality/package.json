{
  "name": "@local/feature-quality",
  "version": "2.0.0",
  "private": true,
  "description": "Adds a Quality prompt control above the message composer, the /quality command and /quality-status: fills the Generic Feature Quality Prompt, previews it, opens it as the session's next user message, and tracks the run's deliverables.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/",
    "client.js",
    "prompt.md",
    "defaults.json",
    "tools/",
    "templates/",
    "eval/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
