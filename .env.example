# Database
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack_dev
POSTGRES_DB=fittrack
DATABASE_URL=postgresql+asyncpg://fittrack:fittrack_dev@db:5432/fittrack

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,https://localhost
PUBLIC_URL=https://localhost

# Account whitelist (comma-separated emails). Empty = allow all.
# Set to your Google email to restrict access, e.g.:
# ALLOWED_EMAILS=you@gmail.com
ALLOWED_EMAILS=

# Frontend — must be empty string; clients use relative URLs via Caddy proxy.
# See AGENTS.md Critical Pitfall #4.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_PUBLIC_URL=https://localhost

# NextAuth
NEXTAUTH_URL=https://localhost/fittrack
NEXTAUTH_SECRET=change-me-to-a-random-secret-key
INTERNAL_API_URL=http://backend:8000

# Caddy domain (defaults to localhost for local dev with self-signed TLS)
DOMAIN=localhost

# Google OAuth (for app login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (for app login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Whoop OAuth
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Wahoo OAuth
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=

# Komoot OAuth
KOMOOT_CLIENT_ID=
KOMOOT_CLIENT_SECRET=

# Komoot Basic Auth
KOMOOT_EMAIL=
KOMOOT_PASSWORD=
KOMOOT_USER_ID=  # Your numeric Komoot user ID (e.g. 4895699973941)

# Merge / dedup thresholds (optional — defaults shown)
ACTIVITY_MERGE_THRESHOLD=0.65
ACTIVITY_ROUTE_LINK_THRESHOLD=0.70

# Google Gemini API Key (free tier — for cycling analysis)
GEMINI_API_KEY=
