# Database
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack_dev
POSTGRES_DB=fittrack
DATABASE_URL=postgresql+asyncpg://fittrack:fittrack_dev@db:5432/fittrack

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD:-redis_dev_password}@redis:6379/0
REDIS_PASSWORD=redis_dev_password

# Backend
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,https://localhost
# Where the backend redirects after OAuth completes. MUST be set in production,
# otherwise the default (https://localhost/fittrack) sends users to localhost.
FRONTEND_URL=https://localhost/fittrack
PUBLIC_URL=https://localhost

# Account whitelist (comma-separated emails). Empty = allow all.
# Set to your Google email to restrict access, e.g.:
# ALLOWED_EMAILS=you@gmail.com
ALLOWED_EMAILS=

# Frontend — must be empty string; clients use relative URLs via Caddy proxy.
# See AGENTS.md Critical Pitfall #4.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_PUBLIC_URL=https://localhost

# NextAuth
NEXTAUTH_URL=https://localhost/fittrack
NEXTAUTH_SECRET=change-me-to-a-random-secret-key
INTERNAL_API_URL=http://backend:8000

# Internal API secret — protects /sync-user from anonymous access. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=

# Caddy domain (defaults to localhost for local dev with self-signed TLS)
DOMAIN=localhost

# Google OAuth (for app login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (for app login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Strava OAuth
# Strava allows only ONE callback domain per API application. To use Strava in
# both dev and prod, create two apps at strava.com/settings/api:
#   - prod app: Authorization Callback Domain = oliradlett.co.uk
#   - dev app:  Authorization Callback Domain = localhost
# Put prod creds in the server .env and dev creds here.
# Callback path (both envs): /api/v1/auth/oauth/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Whoop OAuth
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Wahoo OAuth
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=

# Komoot — uses Basic Auth (email + password), NOT OAuth
KOMOOT_EMAIL=
KOMOOT_PASSWORD=
KOMOOT_USER_ID=  # Optional — auto-detected if not set

# Merge / dedup thresholds (optional — defaults shown)
ACTIVITY_MERGE_THRESHOLD=0.60
ACTIVITY_ROUTE_LINK_THRESHOLD=0.70
ROUTE_MATCH_THRESHOLD=0.60

# Google Gemini API Key (free tier — for cycling analysis)
GEMINI_API_KEY=
