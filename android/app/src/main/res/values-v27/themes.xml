<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 27+ only. The base theme (values/themes.xml) carries everything the
      app needs at minSdk 26; a newer framework attribute referenced from the
      base themes.xml is what Lint's NewApi check flags, and manufacturers whose
      attribute ids collide have historically crashed on it, so the split keeps
      26 untouched.
    -->
    <style name="Theme.FitTrack" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#090E0E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
