node_modules/
dist/
.vite/
*.log

# Frames are regenerated by `node qa/capture.mjs`. Only the composed sheets are
# committed — the 40-odd individual PNGs are 5 MB of build output.
qa/out/*.png
!qa/out/compare-today.png
!qa/out/contact-sheet-desktop.png
!qa/out/contact-sheet-mobile.png
qa/before/*.png
!qa/before/before-evidence.png
qa/before/slices/

# The production-page frames (`node qa/capture-after.mjs`) are regenerated per run
# against the running app; they are evidence, not source.
qa/after/*.png
